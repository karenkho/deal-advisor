# Azure OpenAI endpoint URL, e.g. https://<resource>.cognitiveservices.azure.com/
AZURE_OPENAI_ENDPOINT=
# Azure OpenAI API key (never commit; local .env or container secret only)
AZURE_OPENAI_API_KEY=
# Azure OpenAI REST API version, e.g. 2024-10-21
AZURE_OPENAI_API_VERSION=
# Main chat deployment: extract/consolidate, router, sizing agent, critic
AZURE_OPENAI_MAIN_DEPLOYMENT=
# Light chat deployment: intake guard classifier + injection check (falls back to MAIN)
AZURE_OPENAI_LIGHT_DEPLOYMENT=
# Embedding deployment: corpus + requirement dedup
AZURE_OPENAI_EMBED_DEPLOYMENT=
# Shared password for the Streamlit UI
APP_PASSWORD=
# Optional: tracing is on only when this is exactly true; unset or anything else leaves it off
LANGSMITH_TRACING=
# Optional: LangSmith API key (never commit; local .env or container secret only)
LANGSMITH_API_KEY=
# Optional: LangSmith project name (default deal-advisor-poc)
LANGSMITH_PROJECT=
# Optional: another LangSmith endpoint, e.g. a regional one
LANGSMITH_ENDPOINT=
# Optional: label on a run's traces: dev, test or app (default app)
TRACE_DOCUMENT_SET=
# Max TOR pages processed per run (default 60)
MAX_TOR_PAGES=60
# Max features in the backlog per run (default 80)
MAX_FEATURES=80
# Spend guard: abort a run whose estimated or actual Azure cost exceeds this (USD, default 0.25)
MAX_RUN_USD=0.25
# Spend guard: refuse new uploads for the day once this much has been spent (USD, default 1.00)
MAX_DAILY_USD=1.00
# Spend guard: refuse new runs once the POC's cumulative spend in the local ledger reaches this (USD, default 10.00)
MAX_TOTAL_USD=14.50
# Local testing only: path to a published rates file. Never set in the container.
RATES_FILE=
# Deal Advisor app connection (runtime role): postgresql://dealadvisor_app:<password>@<host>:5432/dealadvisor?sslmode=require
DATABASE_URL=
# Migrations only, local only, never in the container: postgresql://dealadvisor_owner:<password>@<host>:5432/dealadvisor?sslmode=require
DATABASE_URL_OWNER=
# Google Drive OAuth client and refresh token, written by scripts/drive_auth.py (only for storage backend gdrive)
# Path to the OAuth Desktop client file used by scripts/drive_auth.py (keep it outside the repository)
GDRIVE_CLIENT_FILE=
GDRIVE_CLIENT_ID=
GDRIVE_CLIENT_SECRET=
GDRIVE_REFRESH_TOKEN=
# Where documents are published: gdrive or local (default: config/storage.yaml)
STORAGE_BACKEND=
# Folder for the local backend (default: config/storage.yaml)
STORAGE_LOCAL_ROOT=
# off: skip the statement-level extraction cache, for honest stability runs (default on)
EXTRACT_CACHE=
# Test only, never in the container: plants a leak in the proposal to exercise the download block
LEAK_TEST_INJECT=
# Test and evaluation only: how requirements are extracted: ai_checked (default), ai or rules
EXTRACTION_MODE=
# Evaluation only: off reads PDFs without the table extractor
PDF_TABLES=
